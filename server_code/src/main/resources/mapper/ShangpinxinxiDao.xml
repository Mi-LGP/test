<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.ShangpinxinxiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.ShangpinxinxiEntity" id="shangpinxinxiMap">
        <result property="shangpinbianhao" column="shangpinbianhao"/>
        <result property="shangpinmingcheng" column="shangpinmingcheng"/>
        <result property="shangpintupian" column="shangpintupian"/>
        <result property="shangpinxiangqing" column="shangpinxiangqing"/>
        <result property="guige" column="guige"/>
        <result property="baozhiqi" column="baozhiqi"/>
        <result property="shangpinfenlei" column="shangpinfenlei"/>
        <result property="shangjia" column="shangjia"/>
        <result property="price" column="price"/>
        <result property="storeupNumber" column="storeup_number"/>
        <result property="discussNumber" column="discuss_number"/>
        <result property="onelimittimes" column="onelimittimes"/>
        <result property="alllimittimes" column="alllimittimes"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.ShangpinxinxiView" >

		SELECT  shangpinxinxi.* FROM shangpinxinxi  shangpinxinxi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.ShangpinxinxiView" >
		SELECT * FROM shangpinxinxi  shangpinxinxi <where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectHotRanking" resultType="com.cl.entity.view.ShangpinxinxiView">
        SELECT 
            s.*, 
            (IFNULL(s.storeup_number, 0) + IFNULL(s.discuss_number, 0) + IFNULL(o.total_sales, 0)) as score
        FROM 
            shangpinxinxi s
        LEFT JOIN (
            SELECT goodid, SUM(buynumber) as total_sales 
            FROM orders 
            WHERE tablename = 'shangpinxinxi'
            GROUP BY goodid
        ) o ON s.id = o.goodid
        ORDER BY score DESC
        LIMIT 10
    </select>
</mapper>
